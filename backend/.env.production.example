# Example only. Set runtime values in the hosting platform's environment manager.
# Never upload a real .env file or place provider credentials in an image/build arg.
SCENARIOLAB_SERVICE_NAME=scenariolab-api
SCENARIOLAB_ENVIRONMENT=production
SCENARIOLAB_FRONTEND_ORIGIN=https://demo.example.com
SCENARIOLAB_MAX_REQUEST_BODY_BYTES=65536

# Public fallback-only mode. Do not add a provider key for this release.
SCENARIOLAB_AI_ENABLED=false
SCENARIOLAB_AI_MODEL=gpt-4.1-mini
SCENARIOLAB_AI_BASE_URL=https://api.openai.com/v1
SCENARIOLAB_AI_TIMEOUT_SECONDS=10
SCENARIOLAB_AI_MAX_RESPONSE_TOKENS=300
SCENARIOLAB_AI_PROVIDER_CALLS_PER_MINUTE=5
SCENARIOLAB_AI_MAX_CONCURRENT_PROVIDER_CALLS=1

# Enable signed Director gameplay with authored fallback situations.
SCENARIOLAB_DIRECTOR_ENABLED=true
SCENARIOLAB_DIRECTOR_LIVE_GENERATION_ENABLED=false
SCENARIOLAB_DIRECTOR_MAX_RESPONSE_TOKENS=800

# Set these in the hosting runtime environment, not in this template:
# SCENARIOLAB_DIRECTOR_ACTIVE_SIGNING_KEY_ID=<stable-key-id>
# SCENARIOLAB_DIRECTOR_SIGNING_KEYS=<JSON key ring stored as a secret>
